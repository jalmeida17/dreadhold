	",": ["  ", "  ", "  ", "  ", "  ", " #", " #", "# "],
	"-": ["    ", "    ", "    ", "####", "    ", "    ", "    "],
	".": [" ", " ", " ", " ", " ", " ", "#"],
	"/": ["    #", "    #", "   # ", "  #  ", " #   ", "#    ", "#    "],
	"0": [" ### ", "#   #", "#  ##", "# # #", "##  #", "#   #", " ### "],
	"1": [" # ", "## ", " # ", " # ", " # ", " # ", "###"],
