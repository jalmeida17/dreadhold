extends RefCounted
## Hand-made 5x7 proportional pixel font (cap height 7, x-height 5, 2px descenders).
## Each glyph is a list of rows; '#' = ink. Rows 0..6 sit above the baseline, rows 7..8 below.

const CELL_W := 6
const CELL_H := 9
const BASELINE := 7

const GLYPHS := {
