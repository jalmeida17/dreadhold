	"!": ["#", "#", "#", "#", "#", " ", "#"],
	"\"": ["# #", "# #"],
	"#": [" # # ", " # # ", "#####", " # # ", "#####", " # # ", " # # "],
	"$": ["  #  ", " ####", "# #  ", " ### ", "  # #", "#### ", "  #  "],
	"%": ["##  #", "##  #", "   # ", "  #  ", " #   ", "#  ##", "#  ##"],
	"&": [" ##  ", "#  # ", "# #  ", " #   ", "# # #", "#  # ", " ## #"],
