	"x": ["     ", "     ", "#   #", " # # ", "  #  ", " # # ", "#   #"],
	"y": ["     ", "     ", "#   #", "#   #", "#   #", "#   #", " ####", "    #", " ### "],
	"z": ["     ", "     ", "#####", "   # ", "  #  ", " #   ", "#####"],
	"{": ["  #", " # ", " # ", "#  ", " # ", " # ", "  #"],
	"|": ["#", "#", "#", "#", "#", "#", "#"],
	"}": ["#  ", " # ", " # ", "  #", " # ", " # ", "#  "],
	"~": ["     ", "     ", " #   ", "# # #", "   # ", "     ", "     "],
}


static func glyph_width(ch: String) -> int:
	var rows: Array = GLYPHS.get(ch, GLYPHS["?"])
	var wmax := 0
	for r in rows:
		wmax = maxi(wmax, String(r).length())
	return wmax
