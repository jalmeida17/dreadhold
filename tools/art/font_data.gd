	"r": ["    ", "    ", "# ##", "##  ", "#   ", "#   ", "#   "],
	"s": ["     ", "     ", " ####", "#    ", " ### ", "    #", "#### "],
	"t": [" #  ", " #  ", "####", " #  ", " #  ", " #  ", "  ##"],
	"u": ["     ", "     ", "#   #", "#   #", "#   #", "#   #", " ####"],
