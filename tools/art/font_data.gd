	">": ["#   ", " #  ", "  # ", "   #", "  # ", " #  ", "#   "],
	"?": [" ### ", "#   #", "    #", "   # ", "  #  ", "     ", "  #  "],
	"@": [" ### ", "#   #", "# ###", "# # #", "# ###", "#    ", " ####"],
	"A": [" ### ", "#   #", "#   #", "#####", "#   #", "#   #", "#   #"],
